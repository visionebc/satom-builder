# /etc/sudoers.d/satom-builder-installer -- permission to RUN THE INSTALLER.
#
# Installing SATOM Builder means creating an account, installing packages,
# writing systemd units and touching nginx. That IS root: there is no honest
# subset of those operations. What this rule avoids is HANDING OVER THE ROOT
# PASSWORD to whoever installs: a named, audited account may launch one script
# at one fixed path, and nothing else.
#
# Do NOT confuse with /etc/sudoers.d/satom-builder, the SERVICE ACCOUNT's
# two-command runtime allowlist ('nginx -t' and 'systemctl reload nginx').
#
# Generate it for another account name with:
#   bash install-satom-builder.sh --print-sudoers <account>
#
# INSTALLATION:
#   install -d -m 0755 /opt/staging
#   install -m 0755 install-satom-builder.sh /opt/staging/install-satom-builder.sh
#   chown root:root /opt/staging/install-satom-builder.sh   # the operator can NOT edit it
#   install -m 0440 satom-builder-installer.sudoers /etc/sudoers.d/satom-builder-installer
#   visudo -c                                     # validate before logging out
#
# IMPORTANT: the path is fixed and the file is owned by root. If the operator
# could write /opt/staging/install-satom-builder.sh, the rule would amount to
# NOPASSWD: ALL. An offline install also needs bundle/ next to the script,
# root-owned for the same reason.
#
# Withdraw the rule when the installation window closes:
#   rm /etc/sudoers.d/satom-builder-installer

Cmnd_Alias SATOM_BUILDER_INSTALL = /usr/bin/bash /opt/staging/install-satom-builder.sh, \
                                   /usr/bin/bash /opt/staging/install-satom-builder.sh --preflight, \
                                   /usr/bin/bash /opt/staging/install-satom-builder.sh --check, \
                                   /usr/bin/bash /opt/staging/install-satom-builder.sh --dry-run

sbinstall ALL=(root) NOPASSWD: SATOM_BUILDER_INSTALL

# Auditing: every invocation lands in the journal (journalctl _COMM=sudo) and
# the installer always writes /var/log/satom-builder-install.log.
