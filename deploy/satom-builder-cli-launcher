#!/usr/bin/env python3
"""SATOM Builder operator CLI launcher -- installed as /usr/local/sbin/satom-builder.

Deliberately tiny and deliberately NOT in the app tree. It loads the CLI from
/usr/local/lib/satom-builder-cli, which is root-owned. If it instead exec'd
/opt/satom-builder/deploy/..., a compromised web worker (which owns the app
tree) could rewrite the code an operator is about to run under sudo.
deploy/install-cli.sh stamps the first line with a system interpreter.
"""
import sys

sys.path.insert(0, "/usr/local/lib/satom-builder-cli")

try:
    from satom_builder_cli.main import main
except ImportError as exc:  # noqa: BLE001
    sys.stderr.write(
        "satom-builder: CLI library missing or unreadable (%s).\n"
        "Reinstall it from the app tree:\n"
        "  sudo bash /opt/satom-builder/deploy/install-cli.sh\n" % exc)
    sys.exit(4)

if __name__ == "__main__":
    sys.exit(main())
